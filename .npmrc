auto-install-peers=false
strict-peer-dependencies=false
public-hoist-pattern[]=bindings
public-hoist-pattern[]=file-uri-to-path
public-hoist-pattern[]=node-gyp-build
public-hoist-pattern[]=vite
public-hoist-pattern[]=drizzle-kit
minimumReleaseAge=1440
resolution-mode=highest

# Skip Puppeteer's bundled Chromium download — use system Chromium from Nix
puppeteer_skip_download=true
PUPPETEER_SKIP_DOWNLOAD=true

# Skip Electron download — not needed on Replit
electron_skip_binary_download=true
ELECTRON_SKIP_BINARY_DOWNLOAD=1
