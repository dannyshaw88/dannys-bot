{
  "appId": "com.dannysbot.app",
  "productName": "Danny's Bot",
  "copyright": "Copyright © 2025",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "!dist/**/*.map"
  ],
  "asarUnpack": [
    "dist/server/**",
    "dist/frontend/**",
    "dist/assets/**",
    "node_modules/better-sqlite3/**",
    "**/*.node"
  ],
  "npmRebuild": true,
  "publish": {
    "provider": "github",
    "owner": "dannyshaw88",
    "repo": "dannys-bot",
    "releaseType": "release"
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Danny's Bot"
  }
}
